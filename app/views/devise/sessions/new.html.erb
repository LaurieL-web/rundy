<section class="home-hero">

  <div class="home-hero-content">

    <span class="home-badge">
      COACH APP
    </span>

    <h1 class="home-title">
      FAIS LA
      DIFFÉRENCE
    </h1>

    <p class="home-subtitle">
      Connecte-toi pour créer ou suivre ton objectif
    </p>

    <div class="form-container">

      <%= simple_form_for(
        resource,
        as: resource_name,
        url: session_path(resource_name)
      ) do |f| %>

        <%= f.input :email,
                    label: "Email",
                    required: false,
                    autofocus: true,
                    input_html: { autocomplete: "email" } %>

        <%= f.input :password,
                    label: "Mot de passe",
                    required: false,
                    input_html: { autocomplete: "current-password" } %>

        <%= f.button :submit, "Se connecter", class: "btn-1" %>

      <% end %>

      <div class="devise-links">
        <%= link_to "Créer un compte", new_registration_path(resource_name) %>
        <br>
        <%= link_to "Mot de passe oublié ?", new_password_path(resource_name) %>
      </div>

    </div>

  </div>

</section>
