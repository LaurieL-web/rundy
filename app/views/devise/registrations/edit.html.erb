<section class="devise-hero">

  <div class="devise-hero-content">

    <span class="home-badge">
      MON COMPTE
    </span>

    <h1 class="home-title">
      MODIFIE TON<br>
      PROFIL
    </h1>

    <p class="home-subtitle">
      Mets à jour tes informations de compte
    </p>

    <div class="devise-form-container">

      <%= simple_form_for(
        resource,
        as: resource_name,
        url: registration_path(resource_name),
        html: { method: :put }
      ) do |f| %>

        <%= f.error_notification %>

        <%= f.input :email,
                    label: "Email",
                    required: true,
                    autofocus: true %>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p>
            Confirmation en attente pour :
            <%= resource.unconfirmed_email %>
          </p>
        <% end %>

        <%= f.input :password,
                    label: "Nouveau mot de passe",
                    hint: "Laisse vide si tu ne souhaites pas le modifier",
                    required: false,
                    input_html: { autocomplete: "new-password" } %>

        <%= f.input :password_confirmation,
                    label: "Confirmation du nouveau mot de passe",
                    required: false,
                    input_html: { autocomplete: "new-password" } %>

        <%= f.input :current_password,
                    label: "Mot de passe actuel",
                    hint: "Nécessaire pour confirmer tes modifications",
                    required: true,
                    input_html: { autocomplete: "current-password" } %>

        <%= f.button :submit,
                     "Enregistrer les modifications",
                     class: "btn-2" %>

      <% end %>

      <div class="devise-links">
        <%= link_to "Retour", :back %>
      </div>

    </div>

  </div>

</section>
