<section class="home-hero">

  <div class="home-hero-content">

    <span class="home-badge">
      COACH APP
    </span>

    <h1 class="home-title">
      MOT DE PASSE
      OUBLIÉ ?
    </h1>

    <p class="home-subtitle">
      Entre ton email pour recevoir les instructions de réinitialisation
    </p>

    <div class="form-container">

      <%= simple_form_for(
        resource,
        as: resource_name,
        url: password_path(resource_name),
        html: { method: :post }
      ) do |f| %>

        <%= f.error_notification %>

        <%= f.input :email,
                    label: "Email",
                    required: true,
                    autofocus: true,
                    input_html: { autocomplete: "email" } %>

        <%= f.button :submit,
                     "Réinitialiser mon mot de passe",
                     class: "btn-1" %>

      <% end %>

      <div class="devise-links">
        <%= link_to "Retour à la connexion", new_session_path(resource_name) %>
        <br>
        <%= link_to "Créer un compte", new_registration_path(resource_name) %>
      </div>

    </div>

  </div>

</section>
