<div class="watermark-container">
  <div class="watermark-pattern">
    <% 50.times do %>
      <i class="fa-solid fa-person-running tex-navy"></i>
    <% end %>
  </div>

  <div class="container py-5 section">
  <i class="bi bi-person-running brand-watermark--icon"></i>
  <div class="mb-4">
    <%= link_to objective_seances_path(objective_id: current_user.objectives.last.id), class: "btn btn-outline-secondary" do %>
    <i class="bi bi-arrow-left"></i> Retour
    <% end %>
  </div>

  <div class="seance-hero">
    <span class="seance-hero__badge"><%= @seance.session_type %></span>
    <h1 class="seance-hero__title">Séance – <%= @seance.session_type %></h1>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-6">
      <div class="stat-card">
        <span class="stat-card__label">Distance</span>
        <div class="stat-card__value"><%= @seance.distance %> km</div>
      </div>
    </div>
    <div class="col-6">
      <div class="stat-card">
        <span class="stat-card__label">Allure</span>
        <div class="stat-card__value"><%= @seance.pace %></div>
      </div>
    </div>
  </div>

    <div class="seance-content mb-4">
    <%= @seance.content %>
  </div>

  <div class="d-flex gap-2">
    <%= link_to "Supprimer la séance", seance_path(@seance),
        class: "btn btn-danger",
        data: { turbo_method: :delete, turbo_confirm: "Êtes-vous sûr ?" } %>
    <%= link_to "Modifier", objective_seance_path(@objective, @seance),
        data: { turbo_method: :patch }, class: "btn btn-2" %>
  </div>
</div>
</div>
