
<div id="<%= dom_id(seance) %>" class="list-group-item py-3 <%= 'bg-success-subtle' if seance.status %>">

  <div class="d-flex align-items-center">

    <!-- Statut -->
    <div class="me-3">
      <%= link_to update_seance_status_path(
            objective_id: objective.id,
            id: seance.id
          ),
          data: { turbo_method: :patch },
          class: "text-decoration-none" do %>

        <% if seance.status %>
          <i class="fa-solid fa-circle-check fs-4"
            style="color: #224870;"></i>
        <% else %>
          <i class="fa-regular fa-circle fs-4"
            style="color: #224870;"></i>
        <% end %>

      <% end %>
    </div>

    <!-- Informations séance -->
    <%= link_to objective_seance_path(@objective, seance),
        class: "flex-grow-1 text-decoration-none text-dark d-flex justify-content-between align-items-center" do %>

      <div>
        <div class="fw-semibold">
          Séance <%= seance.index %>
          -
          <%= seance.session_type.capitalize %>
        </div>

        <small class="text-muted">
          <%= seance.distance %> km
          ·
          <%= seance.pace %>
        </small>
      </div>

      <div class="text-muted ms-3">
        →
      </div>

    <% end %>

  </div>

</div>
