<section class="home-hero">

  <div class="home-hero-content">

  <span class="home-badge">
    COACH APP
  </span>

  <h1 class="home-title">
    MAKE THE<br>
    DIFFERENCE
  </h1>

  <p class="home-subtitle">
    Login for create a objectif
  </p>
  <div class="objective-form">

      <%= simple_form_for @objective, url: objectives_path do |f| %>

        <%= f.input :distance, label: "Distance" %>

        <%= f.input :target_time, label: "Temps objectif" %>

        <%= f.input :prepa_duration, label: "Durée de préparation" %>

        <%= f.input :frequency, label: "Nombre de séances par semaine" %>

        <%= f.submit "Créer mon objectif", class: "btn btn-primary w-100" %>

      <% end %>

    </div>

</div>

</section>
