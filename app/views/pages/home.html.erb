<section class="home-hero">

  <div class="home-hero-content">

    <span class="home-badge">
      COACH APP
    </span>

    <h1 class="home-title">
      FAIS LA DIFFÉRENCE
    </h1>

    <p class="home-subtitle">
      Crée ton objectif et commence ta préparation
    </p>

    <div class="form-container">

      <%= simple_form_for @objective, url: objectives_path do |f| %>

        <%= f.input :distance,
                    label: "Distance (km)" %>

        <%= f.input :target_time,
            label: "Temps objectif",
            placeholder: "1h00" %>

        <%= f.input :prepa_duration,
                    label: "Durée de préparation (semaines)" %>

        <%= f.input :frequency,
                    label: "Nombre de séances par semaine" %>

        <%= f.submit "Créer mon objectif",
                     class: "btn-1" %>

      <% end %>

    </div>

  </div>

</section>
