<h1>Pages#home</h1>
<%= form_for(User.new, as: :user, url: session_path(:user)) do |f| %>
  <div>
    <%= f.email_field :email, placeholder: "Email" %>
  </div>

  <div>
    <%= f.password_field :password, placeholder: "Mot de passe" %>
  </div>

  <%= f.submit "Se connecter" %>
<% end %>

<%= link_to "Créer un compte", new_user_registration_path %>
<%= button_to "Se déconnecter", destroy_user_session_path, method: :delete %>
<p>Find me in app/views/pages/home.html.erb</p>
