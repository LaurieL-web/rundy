<h1>Pages#home</h1>

  <%= simple_form_for @objective, url: objectives_path, method: :post do |f| %>

    <%= f.input :distance, label: "Distance" %>

    <%= f.input :target_time, label: "Temps objectif" %>

    <%= f.input :prepa_duration, label: "Durée de préparation" %>

    <%= f.input :frequency, label: "Nombre de séances par semaine" %>

    <%= f.submit "Créer mon objectif", class: "btn btn-primary" %>

  <% end %>
<p>Find me in app/views/pages/home.html.erb</p>
