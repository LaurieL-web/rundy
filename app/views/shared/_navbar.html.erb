<div class="navbar navbar-expand-sm navbar-dark" style="background-color: #122C34;">
  <div class="container-fluid">

    <%= link_to root_path, class: "navbar-brand" do %>
      <%= image_tag "LOGO_RUNDY.png", width: 100 %>
    <% end %>

    <button
      class="navbar-toggler border-0 shadow-none"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarSupportedContent"
      aria-controls="navbarSupportedContent"
      aria-expanded="false"
      aria-label="Toggle navigation">

      <i class="fa-solid fa-bars fs-2 text-white"></i>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">

      <ul class="navbar-nav ms-auto align-items-center gap-3">

        <% if user_signed_in? %>

          <li class="nav-item">
            <%= link_to "Créer un objectif",
                        root_path,
                        class: "nav-link text-white" %>
          </li>

          <% if current_user.objectives.any? %>
            <li class="nav-item">
              <%= link_to "Voir mon programme",
                          objective_seances_path(objective_id: current_user.objectives.last.id),
                          class: "nav-link text-white" %>
            </li>
          <% end %>

          <li class="nav-item dropdown ms-3">

            <i
              class="fa-solid fa-circle-user fs-2 text-white"
              id="navbarDropdown"
              data-bs-toggle="dropdown"
              aria-haspopup="true"
              aria-expanded="false">
            </i>

            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">

              <%= link_to "Se déconnecter",
                          destroy_user_session_path,
                          class: "dropdown-item",
                          data: { turbo_method: :delete } %>

            </div>

          </li>

        <% else %>

          <li class="nav-item">
            <%= link_to "Se connecter",
                        new_user_session_path,
                        class: "nav-link text-white" %>
          </li>

          <li class="nav-item">
            <%= link_to "S'inscrire",
                        new_user_registration_path,
                        class: "nav-link text-white" %>
          </li>

        <% end %>

      </ul>

    </div>

  </div>
</div>
