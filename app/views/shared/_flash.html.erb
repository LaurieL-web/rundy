<% flash.each do |type, message| %>
  <div class="alert alert-<%= type == "notice" ? "success" : "danger" %> alert-dismissible fade show text-center mx-auto mt-3" style="max-width: 600px;" role="alert">
    <%= message %>
    <button type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Close">
    </button>
  </div>
<% end %>
